<Project Sdk="Microsoft.NET.Sdk">



	<PropertyGroup>

		<TargetFrameworks>net10.0-android;net10.0-ios</TargetFrameworks>

		<AndroidEnableMultiDex>true</AndroidEnableMultiDex>

		<OutputType>Exe</OutputType>

		<RootNamespace>ScanflowMauiDemoApp</RootNamespace>

		<UseMaui>true</UseMaui>

		<SingleProject>true</SingleProject>

		<ImplicitUsings>enable</ImplicitUsings>

		<Nullable>enable</Nullable>

		<AndroidEnableAot>false</AndroidEnableAot>



		<MauiVersion>10.0.60</MauiVersion>



		<ApplicationTitle>ScanflowMauiDemoApp</ApplicationTitle>

		<ApplicationId>com.scanflow.mauidemo</ApplicationId>

		<ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>

		<ApplicationVersion>1</ApplicationVersion>



		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">24.0</SupportedOSPlatformVersion>

		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">13.0</SupportedOSPlatformVersion>

	</PropertyGroup>

	<PropertyGroup Condition="'$(TargetFramework)' == 'net10.0-android'">
		<DefineConstants>$(DefineConstants);ANDROID</DefineConstants>
	</PropertyGroup>
	<PropertyGroup Condition="'$(TargetFramework)' == 'net10.0-ios'">
		<DefineConstants>$(DefineConstants);IOS</DefineConstants>
	</PropertyGroup>



	<PropertyGroup Condition="'$(Configuration)|$(TargetFramework)|$(Platform)'=='Debug|net10.0-android|AnyCPU'">

		<AndroidStoreUncompressedFileExtensions>.tflite</AndroidStoreUncompressedFileExtensions>

		<ApplicationId>com.scanflow.mauidemo</ApplicationId>

	</PropertyGroup>



	<PropertyGroup Condition="'$(Configuration)|$(TargetFramework)|$(Platform)'=='Release|net10.0-android|AnyCPU'">

		<AndroidStoreUncompressedFileExtensions>.tflite</AndroidStoreUncompressedFileExtensions>

		<ApplicationId>com.scanflow.mauidemo</ApplicationId>

		<AndroidPackageFormat>apk</AndroidPackageFormat>

		<AndroidSigningKeyStore>/Users/racitsolutionspvtltd/Downloads/mauiscanflowdemo.jks</AndroidSigningKeyStore>

		<AndroidSigningStorePass>Optisol@2024</AndroidSigningStorePass>

		<AndroidSigningKeyAlias>key0</AndroidSigningKeyAlias>

		<AndroidSigningKeyPass>Optisol@2024</AndroidSigningKeyPass>

		<DebugSymbols>true</DebugSymbols>

		<JavaMaximumHeapSize>1G</JavaMaximumHeapSize>

		<AndroidLinkMode>None</AndroidLinkMode>

	</PropertyGroup>



	<ItemGroup>

		<MauiIcon Include="Resources\AppIcon\appicon.svg" />

		<MauiImage Include="Resources\Images\*" />

		<MauiImage Update="Resources\Images\dotnet_bot.svg" BaseSize="168,208" />

		<MauiFont Include="Resources\Fonts\*" />

		<MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />

	</ItemGroup>



	<ItemGroup>

		<None Remove="Resources\AppIcon\appicon.svg" />

		<None Remove="Resources\Images\*.svg" />

		<None Remove="Resources\Splash\toplogo.svg" />

	</ItemGroup>



	<ItemGroup>

		<MauiSplashScreen Include="Resources\Splash\toplogo.svg" Color="White" />

	</ItemGroup>



	<ItemGroup>

		<None Update="Resources\Splash\splash.svg" Color="white" BaseSize="128,128" />

	</ItemGroup>



	<ItemGroup>

		<PackageReference Include="CommunityToolkit.Maui" Version="14.1.1" />

		<PackageReference Include="InputKit.Maui" Version="4.4.6" />

		<PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.0" />

		<PackageReference Include="Mopups" Version="1.3.1" />

		<PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />

		<PackageReference Include="Microsoft.Maui.Controls.Compatibility" Version="$(MauiVersion)" />

		<PackageReference Include="Scanflow.Barcode.Maui" Version="2.1.0" />

	</ItemGroup>

	<ItemGroup Condition="'$(TargetFramework)' == 'net10.0-android'">

		<PackageReference Include="Xamarin.AndroidX.Tracing.Tracing.Ktx" Version="1.3.0.1" />

	</ItemGroup>

	<!-- NuGet only: Scanflow.Barcode.Maui (Android + shared) + Scanflow.BarcodeCapture.Maui.iOS (iOS binding) -->



	<ItemGroup>

		<MauiXaml Update="Views\HomePage.xaml">

			<Generator>MSBuild:Compile</Generator>

		</MauiXaml>

		<MauiXaml Update="Views\ScanViewPage.xaml">

			<Generator>MSBuild:Compile</Generator>

		</MauiXaml>

	</ItemGroup>



	<PropertyGroup Condition="'$(Configuration)' == 'Release'">

		<RunAOTCompilation>false</RunAOTCompilation>

		<AndroidEnableProfiledAot>false</AndroidEnableProfiledAot>

	</PropertyGroup>



	<PropertyGroup Condition="'$(TargetFramework)'=='net10.0-ios'">

		<ProvisioningType>manual</ProvisioningType>

	</PropertyGroup>



	<ItemGroup>

		<BundleResource Include="$(NuGetPackageRoot)inputkit.maui/4.4.6/contentFiles/any/net10.0-android/icon512.png" Condition="Exists('$(NuGetPackageRoot)inputkit.maui/4.4.6/contentFiles/any/net10.0-android/icon512.png')">

			<NuGetPackageId>InputKit.Maui</NuGetPackageId>

			<NuGetPackageVersion>4.4.6</NuGetPackageVersion>

			<NuGetItemType>None</NuGetItemType>

			<Pack>false</Pack>

			<Private>false</Private>

			<Link>icon512.png</Link>

		</BundleResource>

	</ItemGroup>



	<ItemGroup Condition="'$(TargetFramework)' == 'net10.0-ios'">
	  <PackageReference Include="Scanflow.Barcode.Maui.IOS">
	    <Version>2.1.0</Version>
	  </PackageReference>
	</ItemGroup>







</Project>

